---
import '../styles/global.css';
import { href, REPO_URL, OWNER, SITE_NAME } from '../lib/site.ts';
import { CODE_THEMES, CODE_THEME_STORAGE_KEY } from '../lib/codeThemes.ts';
import CodeThemePicker from '../components/CodeThemePicker.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `System design questions worked end to end by ${OWNER}: requirements, estimates, diagrams and trade-offs.`,
} = Astro.props;

const nav = [
  { label: 'Designs', path: '/' },
  { label: 'Concepts', path: '/concepts/' },
  { label: 'Add', path: '/add/' },
];

const here = Astro.url.pathname.replace(/\/+$/, '/') || '/';
const isCurrent = (path: string) => {
  const target = href(path);
  if (path === '/') return here === target || here === target.replace(/\/$/, '');
  return here.startsWith(target) || here.startsWith(target.replace(/\/$/, ''));
};

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const fullTitle = title === 'Designs' ? `${SITE_NAME} — ${OWNER}` : `${title} · ${SITE_NAME}`;
const codeThemeKeys = CODE_THEMES.map((t) => t.key);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={OWNER} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050505" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />

    {/* Apply the stored code theme before first paint; inline on purpose. */}
    <script is:inline define:vars={{ storageKey: CODE_THEME_STORAGE_KEY, keys: codeThemeKeys }}>
      try {
        var stored = localStorage.getItem(storageKey);
        if (stored && keys.indexOf(stored) !== -1) {
          document.documentElement.setAttribute('data-code-theme', stored);
        }
      } catch (e) {
        /* storage blocked — the default theme is already correct */
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="sticky top-0 z-50 border-b border-line bg-bg/72 backdrop-blur-[20px]">
      <div class="shell flex h-14 items-center gap-2 sm:gap-3">
        <a
          href={href('/')}
          class="group flex shrink-0 items-center gap-2.5 rounded-chip px-0.5 py-1 sm:px-1"
          aria-label={`${SITE_NAME} — home`}
        >
          <span
            class="grid h-6 w-6 place-items-center rounded-md border border-line bg-surface font-mono text-[0.6875rem] leading-none text-fg-muted transition-colors group-hover:text-fg"
            aria-hidden="true">SD</span
          >
          <span class="hidden font-mono text-xs tracking-[0.18em] uppercase sm:inline">sandeep</span>
          <span class="hidden text-xs text-fg-faint md:inline" aria-hidden="true">/</span>
          <span class="hidden text-xs text-fg-subtle md:inline">{SITE_NAME}</span>
        </a>

        <nav
          class="-mx-1 flex min-w-0 flex-1 items-center gap-0.5 overflow-x-auto px-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          aria-label="Primary"
        >
          {
            nav.map((item) => (
              <a class="nav-link" href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <CodeThemePicker />

        <a
          class="nav-link shrink-0"
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Repository on GitHub"
        >
          <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-section border-t border-line">
      <div class="shell flex flex-col gap-3 py-8 text-xs text-fg-subtle sm:flex-row sm:items-center sm:justify-between">
        <p>
          <span class="text-fg-muted">{OWNER}</span> · a running record of system design practice, kept honest.
        </p>
        <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <a class="link-underline hover:text-fg" href={REPO_URL} target="_blank" rel="noopener noreferrer">Source</a>
          <a class="link-underline hover:text-fg" href={href('/add/')}>Add a design</a>
        </p>
      </div>
    </footer>

    <script>
      // ---- Mermaid: render every ```mermaid fence on the page ---------------
      // The library is imported only when a diagram exists, so list pages pay
      // nothing. Each figure keeps its source behind a native <details>.
      const figures = document.querySelectorAll<HTMLElement>('figure.diagram > pre.mermaid');
      if (figures.length) {
        const { default: mermaid } = await import('mermaid');
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'strict',
          theme: 'base',
          fontFamily: 'ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif',
          themeVariables: {
            darkMode: true,
            background: '#0a0a0a',
            fontSize: '14px',
            primaryColor: '#161616',
            primaryTextColor: '#ffffff',
            primaryBorderColor: '#4a4a4a',
            secondaryColor: '#101010',
            secondaryTextColor: '#ffffff',
            secondaryBorderColor: '#3a3a3a',
            tertiaryColor: '#0d0d0d',
            tertiaryTextColor: '#ffffff',
            tertiaryBorderColor: '#333333',
            lineColor: '#9a9a9a',
            textColor: '#ffffff',
            mainBkg: '#161616',
            nodeBorder: '#4a4a4a',
            clusterBkg: '#0d0d0d',
            clusterBorder: '#2e2e2e',
            titleColor: '#ffffff',
            edgeLabelBackground: '#0a0a0a',
            actorBkg: '#161616',
            actorBorder: '#4a4a4a',
            actorTextColor: '#ffffff',
            actorLineColor: '#3a3a3a',
            signalColor: '#d0d0d0',
            signalTextColor: '#ffffff',
            labelBoxBkgColor: '#161616',
            labelBoxBorderColor: '#4a4a4a',
            labelTextColor: '#ffffff',
            loopTextColor: '#ffffff',
            noteBkgColor: '#2a2410',
            noteBorderColor: '#6b5a2a',
            noteTextColor: '#f0e6c8',
            activationBkgColor: '#222222',
            activationBorderColor: '#5a5a5a',
            sequenceNumberColor: '#050505',
            attributeBackgroundColorOdd: '#101010',
            attributeBackgroundColorEven: '#161616',
          },
        });

        let n = 0;
        for (const pre of figures) {
          const figure = pre.parentElement!;
          const source = pre.textContent ?? '';
          try {
            const { svg, bindFunctions } = await mermaid.render(`diagram-${n++}`, source);
            const host = document.createElement('div');
            host.className = 'diagram-svg';
            host.innerHTML = svg;
            bindFunctions?.(host);

            const details = document.createElement('details');
            details.className = 'diagram-source';
            const summary = document.createElement('summary');
            summary.textContent = 'Diagram source';
            const code = document.createElement('pre');
            code.textContent = source;
            details.append(summary, code);

            pre.replaceWith(host);
            figure.append(details);

            // Mermaid caps the SVG at its natural width and lets it shrink to
            // fit. Below 1.5x the figure width, keep the text readable and let
            // the figure scroll instead. Measured after attach, so clientWidth
            // is real.
            const el = host.querySelector('svg');
            const natural = parseFloat(el?.style.maxWidth ?? '');
            const floor = Math.max(640, host.clientWidth * 1.5);
            if (el && natural) el.style.minWidth = `${Math.min(natural, floor)}px`;
          } catch (err) {
            const box = document.createElement('p');
            box.className = 'diagram-error';
            box.textContent = `Diagram failed to render: ${(err as Error).message ?? err}`;
            figure.append(box);
          }
        }
      }

      // ---- Copy button on every code block -----------------------------------
      const RESET_MS = 1600;
      for (const pre of document.querySelectorAll<HTMLElement>('pre.astro-code')) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'btn code-copy';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy code');
        let timer = 0;
        button.addEventListener('click', () => {
          const text = pre.querySelector('code')?.textContent ?? '';
          navigator.clipboard?.writeText(text).then(
            () => done(true),
            () => done(false),
          );
        });
        const done = (ok: boolean) => {
          button.textContent = ok ? 'Copied' : 'Failed';
          button.dataset.copied = String(ok);
          window.clearTimeout(timer);
          timer = window.setTimeout(() => {
            button.textContent = 'Copy';
            delete button.dataset.copied;
          }, RESET_MS);
        };
        pre.prepend(button);
      }
    </script>
  </body>
</html>
